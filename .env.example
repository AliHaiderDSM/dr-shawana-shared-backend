# ---- Server ----
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ---- Database (Supabase "Session pooler" URI, SSL is always on) ----
# Supabase dashboard -> Project Settings -> Database -> Connection string -> Session pooler
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional. SEPARATE database used only by `npm test`; leave empty if you are not running tests (second Supabase project or any Postgres).
# Tests refuse to run if this equals DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres.<test-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Set to false only for a local non-SSL Postgres used in tests.
DATABASE_SSL=true
# Optional: path to the Supabase CA cert (Dashboard -> Database -> SSL). When set, the server cert is verified.
DATABASE_SSL_CA=
# Max DB connections per app instance (the Supabase session pooler has a client limit)
DATABASE_POOL_MAX=10

# ---- Supabase API (server-side only; the service-role key never leaves the backend) ----
# NOT the database string. SUPABASE_URL is the project API URL (https://<ref>.supabase.co), used for Auth + Storage.
# All three values: Supabase dashboard -> Project Settings -> API. Needed for login and staff management (B1+).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ---- HTTP ----
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3001

# ---- Bootstrap Super Admin (used by `npm run seed:super-admin` in B1) ----
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
